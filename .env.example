# blitzid environment variables — copy to .env and adjust.
# All optional; unset means default behavior.

# Directory for all model weights (SCRFD + RapidOCR). Default: the
# platformdirs user cache (~/.cache/blitzid/models on Linux).
# For docker compose: point at a mounted volume so containers share
# one copy instead of re-downloading on every start, e.g.:
#   volumes: [ "./models:/models" ]
#   environment: { BLITZID_MODELS_DIR: /models }
#BLITZID_MODELS_DIR=/models

# Set to 1 to run the OCR/MRZ integration tests (downloads RapidOCR
# models, needs network). Unit test suites skip them otherwise.
#BLITZID_OCR_INTEGRATION=1
