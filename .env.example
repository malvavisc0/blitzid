# blitzid environment variables — copy to .env and adjust.
# Most are optional; unset means the code default. The BLITZID_LLM_*
# trio is required for StructuredOCRReader and the structured/consistency
# analyses (all included in blitzid). The hosted website stack also needs
# POSTGRES_PASSWORD and, in production, SESSION_SECRET.

# Directory for all model weights (YuNet, SFace, FairFace, MiniFASNet,
# PP-OCR). Default: the platformdirs user cache
# (~/.cache/blitzid/models on Linux).
# For docker compose: point at a mounted volume so containers share
# one copy instead of re-downloading on every start, e.g.:
#   volumes: [ "./models:/models" ]
#   environment: { BLITZID_MODELS_DIR: /models }
#BLITZID_MODELS_DIR=/models

# Set to 1 to run the OCR/MRZ integration tests (downloads RapidOCR
# models, needs network). They are skipped otherwise.
#BLITZID_OCR_INTEGRATION=1

# ── LLM structured extraction (included in blitzid) ──────────

# OpenAI-compatible chat endpoint (e.g. vLLM) the StructuredOCRReader
# calls to build structured output from OCR text (and the `structured`
# analysis type of the HTTP API). Required: pass them here or as
# StructuredOCRReader constructor arguments.
#BLITZID_LLM_BASE_URL=http://127.0.0.1:9090/v1
#BLITZID_LLM_API_KEY=sk-...
#BLITZID_LLM_MODEL=Qwen3.8-9B

# ── Langfuse tracing of the LLM calls (included in blitzid) ───

# Opt-in: set both keys to enable tracing of the structured-extraction
# agent; unset means no tracing. Spans carry the OCR text fed to the
# model (names, document numbers, dates) — point BASE_URL at a
# Langfuse instance you control.
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
#LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── HTTP API (blitzid[api] extra) ─────────────────────────────

# Redis the API's job store talks to. The docker-compose redis
# (persistence disabled — jobs live in RAM only) is wired for you;
# override only for external Redis instances.
#BLITZID_API_REDIS_URL=redis://redis:6379/0

# Upload size cap in MB (413 above it).
#BLITZID_API_MAX_UPLOAD_MB=20

# Lifetime of every job key in seconds (result is 410 Gone after).
#BLITZID_API_JOB_TTL_SECONDS=900

# Queue capacity (503 + Retry-After when full).
#BLITZID_API_MAX_QUEUED_JOBS=50

# Analyses running at once per API process.
#BLITZID_API_MAX_CONCURRENT_JOBS=2

# Claim lease in seconds — a worker crash past this lease re-runs the
# job instead of losing it (lease sweeper).
#BLITZID_API_JOB_LEASE_SECONDS=120

# ── Hosted website / compose stack ───────────────────────────

# Required by the postgres service. Use a long random value.
POSTGRES_PASSWORD=change-me

# Signs the session cookie. Required when ENVIRONMENT=production;
# development falls back to a per-process random key.
SESSION_SECRET=change-me

# Public origin for OAuth redirects and Stripe return URLs.
# Set the https:// origin in production (default: http://localhost:8001).
#APP_BASE_URL=https://blitzid.io

# production forces secure cookies. The local compose overlay sets
# development for no-charge preview billing.
#ENVIRONMENT=production

# OAuth providers. Login stays in preview mode when unset.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# Stripe (checkout, portal, and webhooks are disabled when unset).
#STRIPE_SECRET_KEY=sk_live_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_PRICE_STARTER_MONTHLY=price_...
#STRIPE_PRICE_PRO_MONTHLY=price_...

# Hosted API-key enforcement. The compose file derives the database URL
# from POSTGRES_PASSWORD; override only for an external database.
#BLITZID_SAAS_DATABASE_URL=postgresql://blitzid:change-me@postgres:5432/blitzid
#BLITZID_API_AUTH_REQUIRED=1

# Coolify deployment (docker-compose.coolify.yml): full https URLs used by
# the Caddy labels, plus the release tag to pull.
#BLITZID_WEB_DOMAIN=https://blitzid.io
#BLITZID_API_DOMAIN=https://api.blitzid.io
#BLITZID_IMAGE_TAG=v0.5.0
