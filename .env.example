# blitzid environment variables — copy to .env and adjust.
# Most are optional; unset means default behavior. The BLITZID_LLM_*
# trio is required for StructuredOCRReader (blitzid[ocr] extra).

# Directory for all model weights (SCRFD + RapidOCR). Default: the
# platformdirs user cache (~/.cache/blitzid/models on Linux).
# For docker compose: point at a mounted volume so containers share
# one copy instead of re-downloading on every start, e.g.:
#   volumes: [ "./models:/models" ]
#   environment: { BLITZID_MODELS_DIR: /models }
#BLITZID_MODELS_DIR=/models

# Set to 1 to run the OCR/MRZ integration tests (downloads RapidOCR
# models, needs network). Unit test suites skip them otherwise.
#BLITZID_OCR_INTEGRATION=1

# ── LLM structured extraction (blitzid[ocr] extra) ───────────

# OpenAI-compatible chat endpoint (e.g. vLLM) the StructuredOCRReader
# calls to build structured output from OCR text. Required: pass them
# here or as StructuredOCRReader constructor arguments.
#BLITZID_LLM_BASE_URL=http://127.0.0.1:9090/v1
#BLITZID_LLM_API_KEY=sk-aria
#BLITZID_LLM_MODEL=Qwen3.8-9B

# ── Langfuse tracing of the LLM calls (blitzid[ocr] extra) ────

# Opt-in: set both keys to enable tracing of the structured-extraction
# agent; unset means no tracing. Spans carry the OCR text fed to the
# model (names, document numbers, dates) — point BASE_URL at a
# Langfuse instance you control.
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
#LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── HTTP API (blitzid[api] extra) ─────────────────────────────

# Redis the API's job store talks to. The docker-compose redis
# (persistence disabled — jobs live in RAM only) is wired for you;
# override only for external Redis instances.
#BLITZID_API_REDIS_URL=redis://redis:6379/0

# Upload size cap in MB (413 above it).
#BLITZID_API_MAX_UPLOAD_MB=20

# Lifetime of every job key in seconds (result is 410 Gone after).
#BLITZID_API_JOB_TTL_SECONDS=900

# Queue capacity (503 + Retry-After when full).
#BLITZID_API_MAX_QUEUED_JOBS=50

# Analyses running at once per API process.
#BLITZID_API_MAX_CONCURRENT_JOBS=2

# Claim lease in seconds — a worker crash past this lease re-runs the
# job instead of losing it (lease sweeper).
#BLITZID_API_JOB_LEASE_SECONDS=120
