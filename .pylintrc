[MASTER]
# OpenCV is a C-extension; pylint cannot introspect its members without allow-listing.
extension-pkg-allow-list=cv2

[TYPECHECK]
# OpenCV populates many members dynamically (e.g. cv2.dnn, cv2.cuda). Silence no-member.
generated-members=cv2.*,cv2.dnn.*,cv2.cuda.*

[FORMAT]
max-line-length=100
